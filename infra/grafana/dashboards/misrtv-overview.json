{
  "title": "MisrTV Overview",
  "version": 1,
  "panels": [
    {
      "title": "Total Movies",
      "type": "stat",
      "targets": [
        {
          "expr": "count(misrtv_movies_total)",
          "legendFormat": "Movies"
        }
      ],
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 }
    },
    {
      "title": "Movies by Year",
      "type": "barchart",
      "targets": [
        {
          "expr": "misrtv_movies_by_year",
          "legendFormat": "{{year}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }
    },
    {
      "title": "Top Rated Movies",
      "type": "table",
      "targets": [
        {
          "expr": "misrtv_top_movies",
          "legendFormat": "{{title}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 }
    },
    {
      "title": "API Response Time (p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(misrtv_api_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 }
    }
  ]
}
